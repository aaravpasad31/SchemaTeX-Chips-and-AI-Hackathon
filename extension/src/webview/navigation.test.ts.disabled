/**
 * Unit tests for DiagramNavigation
 * Tests zoom, pan, and fit-to-screen functionality
 */

import { DiagramNavigation, SVGBounds, ContainerBounds } from './navigation';

describe('DiagramNavigation', () => {
	let nav: DiagramNavigation;

	beforeEach(() => {
		nav = new DiagramNavigation();
	});

	describe('Zoom', () => {
		test('should initialize at 100% zoom', () => {
			expect(nav.getZoom()).toBe(1.0);
		});

		test('zoomIn should increase zoom', () => {
			nav.zoomIn();
			expect(nav.getZoom()).toBeGreaterThan(1.0);
		});

		test('zoomOut should decrease zoom', () => {
			const initialZoom = nav.getZoom();
			nav.zoomOut();
			expect(nav.getZoom()).toBeLessThan(initialZoom);
		});

		test('should enforce min zoom (20%)', () => {
			nav.setZoom(0.1); // Try to set below min
			expect(nav.getZoom()).toBe(0.2);
		});

		test('should enforce max zoom (500%)', () => {
			nav.setZoom(10); // Try to set above max
			expect(nav.getZoom()).toBe(5.0);
		});

		test('should allow zoom within range', () => {
			nav.setZoom(2.5);
			expect(nav.getZoom()).toBe(2.5);
		});
	});

	describe('Pan', () => {
		test('should initialize at no pan', () => {
			const pan = nav.getPan();
			expect(pan.x).toBe(0);
			expect(pan.y).toBe(0);
		});

		test('pan should move diagram', () => {
			nav.pan(50, 100);
			const pan = nav.getPan();
			expect(pan.x).toBe(50);
			expect(pan.y).toBe(100);
		});

		test('pan should accumulate', () => {
			nav.pan(50, 100);
			nav.pan(25, 50);
			const pan = nav.getPan();
			expect(pan.x).toBe(75);
			expect(pan.y).toBe(150);
		});

		test('setPan should set absolute position', () => {
			nav.pan(50, 100);
			nav.setPan(100, 200);
			const pan = nav.getPan();
			expect(pan.x).toBe(100);
			expect(pan.y).toBe(200);
		});
	});

	describe('Fit to Screen', () => {
		test('should fit diagram to container', () => {
			const svgBounds: SVGBounds = { x: 0, y: 0, width: 1000, height: 800 };
			const containerBounds: ContainerBounds = { width: 500, height: 400 };

			nav.fitToScreen(svgBounds, containerBounds);

			const zoom = nav.getZoom();
			expect(zoom).toBeLessThanOrEqual(0.5); // Should zoom out to fit
			expect(zoom).toBeGreaterThan(0); // But stay positive
		});

		test('should center diagram after fit', () => {
			const svgBounds: SVGBounds = { x: 0, y: 0, width: 1000, height: 800 };
			const containerBounds: ContainerBounds = { width: 500, height: 400 };

			nav.fitToScreen(svgBounds, containerBounds);

			const pan = nav.getPan();
			// After fitting and centering, pan values should position diagram in center
			expect(pan.x).toBeGreaterThan(0); // Positive pan to center
			expect(pan.y).toBeGreaterThan(0);
		});

		test('should handle small diagrams', () => {
			const svgBounds: SVGBounds = { x: 0, y: 0, width: 100, height: 100 };
			const containerBounds: ContainerBounds = { width: 1000, height: 1000 };

			nav.fitToScreen(svgBounds, containerBounds);

			const zoom = nav.getZoom();
			// Should be able to zoom to fit (might be 1.0 or less if no padding exceeded)
			expect(zoom).toBeGreaterThan(0);
			expect(zoom).toBeLessThanOrEqual(1.0);
		});
	});

	describe('Reset', () => {
		test('should reset to initial state', () => {
			nav.zoomIn();
			nav.pan(100, 200);

			nav.reset();

			expect(nav.getZoom()).toBe(1.0);
			const pan = nav.getPan();
			expect(pan.x).toBe(0);
			expect(pan.y).toBe(0);
		});
	});

	describe('State Management', () => {
		test('getState should return current state', () => {
			nav.setZoom(2.0);
			nav.setPan(100, 200);

			const state = nav.getState();
			expect(state.zoom).toBe(2.0);
			expect(state.panX).toBe(100);
			expect(state.panY).toBe(200);
		});
	});

	describe('Transform Strings', () => {
		test('getTransform should return CSS transform', () => {
			nav.setZoom(2.0);
			nav.setPan(100, 200);

			const transform = nav.getTransform();
			expect(transform).toContain('translate(100px, 200px)');
			expect(transform).toContain('scale(2)');
		});

		test('getSVGTransform should return SVG transform', () => {
			nav.setZoom(2.0);
			nav.setPan(100, 200);

			const transform = nav.getSVGTransform();
			expect(transform).toContain('translate(100 200)');
			expect(transform).toContain('scale(2)');
		});
	});
});
