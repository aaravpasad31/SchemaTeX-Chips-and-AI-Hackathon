{
  "name": "schematex",
  "displayName": "SchemaTeX",
  "description": "Synchronized diagrams for SystemVerilog hardware design",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onCommand:schematex.showDiagram"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "schematex.showDiagram",
        "title": "Show Diagram",
        "category": "SchemaTeX"
      },
      {
        "command": "schematex.simplify",
        "title": "Simplify with AI",
        "category": "SchemaTeX"
      },
      {
        "command": "schematex.exportDiagram",
        "title": "Export Diagram",
        "category": "SchemaTeX"
      },
      {
        "command": "schematex.setApiKey",
        "title": "Set Claude API Key",
        "category": "SchemaTeX"
      }
    ],
    "keybindings": [
      {
        "command": "schematex.showDiagram",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/chai": "^4.3.5",
    "@types/d3": "^7.0.8",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/node-fetch": "^2.6.1",
    "@types/react": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@vscode/test-electron": "^2.3.0",
    "chai": "^4.3.7",
    "mocha": "^10.0.0",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "d3": "^7.6.1",
    "elkjs": "^0.8.2",
    "node-fetch": "^2.6.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
